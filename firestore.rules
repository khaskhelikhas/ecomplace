rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Admin is a signed custom claim on the ID token (set via
    // `npm run set-admin <email>` in src/backend). It cannot be forged from
    // the client and no admin identity ships in the web bundle.
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == userId
                    && request.resource.data.get('subscriptionPlan', 'free') == 'free';
      // A user may edit their own profile but NOT their own plan; an admin
      // (or, later, the Stripe webhook's service account) may change plans.
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == userId
            && request.resource.data.get('subscriptionPlan', 'free')
               == resource.data.get('subscriptionPlan', 'free'));
      allow delete: if false;

      match /sourcing/{itemId} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /products/{productId} {
      allow read: if signedIn();
      allow write: if false;
      match /priceHistory/{entryId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    // Public so the marketing landing + static SEO generator can read it.
    match /snapshots/{snapId} {
      allow read: if true;
      allow write: if false;
    }

    // Admin audit trail — admin-only, append-only.
    match /adminLog/{entryId} {
      allow read, list, create: if isAdmin();
      allow update, delete: if false;
    }

    // Manual upgrade requests: a user creates & reads their own; an admin
    // reads all and resolves them. Users cannot change status.
    match /paymentRequests/{reqId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /alerts/{alertId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
