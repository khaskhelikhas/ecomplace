rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Super-admin allowlist. Add / remove emails here (must match the
    // ADMIN_EMAILS list in the frontend).
    function isAdmin() {
      return signedIn() && request.auth.token.email in [
        'safdaraleekhaskheli@gmail.com',
        'saifee.khaskheli@gmail.com'
      ];
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == userId
                    && request.resource.data.get('subscriptionPlan', 'free') == 'free';
      // A user may edit their own profile but NOT their own plan; an admin
      // (or, later, the Stripe webhook's service account) may change plans.
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == userId
            && request.resource.data.get('subscriptionPlan', 'free')
               == resource.data.get('subscriptionPlan', 'free'));
      allow delete: if false;

      match /sourcing/{itemId} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /products/{productId} {
      allow read: if signedIn();
      allow write: if false;
      match /priceHistory/{entryId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    // Public so the marketing landing + static SEO generator can read it.
    match /snapshots/{snapId} {
      allow read: if true;
      allow write: if false;
    }

    match /alerts/{alertId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
