# Frontend production build configuration
#
# Set this to the public URL of your deployed backend API.
# The backend is a Node/Express server and CANNOT run on Firebase Hosting -
# host it on Render, Railway, Fly.io, or a VPS, then put its URL here.
#
# Example:
#   VITE_API_URL=https://ecomplace-api.onrender.com

VITE_API_URL=
