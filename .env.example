# Environment Configuration for EcomPlace
#
# The app runs with NO .env file at all - these are all optional overrides.
# Copy to ".env" only if you want to change defaults or add real API keys.

# === Server ===
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# === Database ===
# Local SQLite file - created automatically. No database server required.
# Override the path if you want the file somewhere else:
# DB_FILE=D:\ecomplace\src\backend\data\ecomplace.sqlite

# === Product Source APIs (optional) ===
# Leave blank to run on generated demo/mock data.
# Add real keys to pull live data from Amazon / Walmart / AliExpress.
KEEPA_API_KEY=
WALMART_API_KEY=
WALMART_API_SECRET=
ALIEXPRESS_AFFILIATE_ID=
RAINFOREST_API_KEY=

# === Authentication ===
JWT_SECRET=dev-secret-key-change-in-production
JWT_EXPIRE=7d

# === Email Service (optional - for price-drop alerts) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@ecomplace.dev

# === Payment Gateway (optional - Stripe, for SaaS billing) ===
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=

# === Logging ===
LOG_LEVEL=info

# === Scheduler ===
SCHEDULER_INTERVAL_MINUTES=20
MAX_PRODUCTS_PER_FETCH=500
